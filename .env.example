# Токен бота из @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# API ключ от themoviedb.org (v3 auth ключ или v4 bearer токен)
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3

# База данных SQLite
DATABASE_URL=sqlite+aiosqlite:///./data/kinozhdun.db

# Интервалы проверок (в часах) и лимиты
CHECK_INTERVAL_HOURS=6
ANNOUNCED_CHECK_INTERVAL_HOURS=2
MAX_ITEMS_PER_USER=50

# Юзернейм бота (без @), если требуется переопределить автоопределение
BOT_USERNAME=kinojdun_bot

# Настройки Telegram-канала «Кинождун»
# Укажите юзернейм публичного канала (например, @kinojdun_channel) или его числовой ID (например, -1001234567890)
TELEGRAM_CHANNEL_ID=
# Включение автоматической публикации (true/false)
CHANNEL_POSTING_ENABLED=false
# Режим публикации: true — сразу публиковать (с соблюдением интервала), false — сохранять в очередь pending
CHANNEL_AUTO_PUBLISH=true
# Минимальный интервал между публикациями в канале в минутах (антиспам)
CHANNEL_MIN_POST_INTERVAL_MINUTES=15
