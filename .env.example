# Токен бота из @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# API ключ от themoviedb.org (v3 auth ключ или v4 bearer токен)
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3

# База данных SQLite
DATABASE_URL=sqlite+aiosqlite:///./data/kinozhdun.db

# Интервалы проверок (в часах) и лимиты
CHECK_INTERVAL_HOURS=6
ANNOUNCED_CHECK_INTERVAL_HOURS=2
MAX_ITEMS_PER_USER=50

# Юзернейм бота (без @), если требуется переопределить автоопределение
BOT_USERNAME=kinojdun_bot

# Настройки Telegram-канала «Кинождун 🍿»
# Укажите юзернейм публичного канала (например, @kinojdun_channel) или его числовой ID (например, -1001234567890)
TELEGRAM_CHANNEL_ID=
# Включение публикаций в канал (true/false)
CHANNEL_POSTING_ENABLED=false
# Режим публикации:
# true — AUTO MODE (автоматическая публикация подтверждённых новостей с соблюдением интервала)
# false — SAFE MODE (новости попадают в очередь pending, администратор подтверждает в боте)
CHANNEL_AUTO_PUBLISH=false
# Минимальный интервал между публикациями в канале в минутах (антиспам)
CHANNEL_MIN_POST_INTERVAL_MINUTES=15

# Telegram ID администраторов через запятую (для доступа к /admin, /queue, /stats и модерации публикаций)
ADMIN_USER_IDS=

# Регулярные дайджесты в канал
# Часы указаны по Москве (Europe/Moscow): ежедневный в 09:30, недельный в 10:00.
DAILY_DIGEST_ENABLED=true
DAILY_DIGEST_HOUR=9
WEEKLY_DIGEST_ENABLED=true
WEEKLY_DIGEST_DAY=0
WEEKLY_DIGEST_HOUR=10

# Локальный сайт и автономная редакция (python -m website)
SITE_HOST=127.0.0.1
SITE_PORT=8099
SITE_BASE_URL=http://127.0.0.1:8099
# false для локального просмотра; true только после публикации на реальном домене
SITE_PUBLIC=false
SITE_SYNC_INTERVAL_MINUTES=60
SITE_BATCH_SIZE=12
# При необходимости переопределите публичную ссылку канала
SITE_CHANNEL_URL=https://t.me/kinojdun_channel

# SEO-верификация и аналитика
SITE_YANDEX_VERIFICATION=
SITE_GOOGLE_VERIFICATION=
SITE_YANDEX_METRIKA_ID=
