# Токен бота из @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Docker: reachable Telegram API edge on the production hosting network.
TELEGRAM_API_IP=149.154.167.220

# API ключ от themoviedb.org (v3 auth ключ или v4 bearer токен)
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3

# База данных SQLite
DATABASE_URL=sqlite+aiosqlite:///./data/kinozhdun.db

# Интервалы проверок (в часах) и лимиты
CHECK_INTERVAL_HOURS=6
ANNOUNCED_CHECK_INTERVAL_HOURS=2
MAX_ITEMS_PER_USER=50

# Юзернейм бота (без @), если требуется переопределить автоопределение
BOT_USERNAME=kinojdun_bot

# Настройки Telegram-канала «Кинождун 🍿»
# Укажите юзернейм публичного канала (например, @kinojdun_channel) или его числовой ID (например, -1001234567890)
TELEGRAM_CHANNEL_ID=
# Включение публикаций в канал (true/false)
CHANNEL_POSTING_ENABLED=false
# Режим публикации:
# true — AUTO MODE (автоматическая публикация подтверждённых новостей с соблюдением интервала)
# false — SAFE MODE (новости попадают в очередь pending, администратор подтверждает в боте)
CHANNEL_AUTO_PUBLISH=false
# Минимальный интервал между публикациями в канале в минутах (антиспам)
CHANNEL_MIN_POST_INTERVAL_MINUTES=15

# Telegram ID администраторов через запятую (для доступа к /admin, /queue, /stats и модерации публикаций)
ADMIN_USER_IDS=

# Регулярные дайджесты в канал
# Часы указаны по Москве (Europe/Moscow): ежедневный в 09:30, недельный в 10:00.
DAILY_DIGEST_ENABLED=true
DAILY_DIGEST_HOUR=9
# В день недельной подборки ежедневная пропускается
DAILY_DIGEST_SKIP_WEEKLY_DAY=true
WEEKLY_DIGEST_ENABLED=true
WEEKLY_DIGEST_DAY=0
WEEKLY_DIGEST_HOUR=10

# Локальный сайт и автономная редакция (python -m website)
SITE_HOST=127.0.0.1
SITE_PORT=8099
SITE_BASE_URL=http://127.0.0.1:8099
# false для локального просмотра; true только после публикации на реальном домене
SITE_PUBLIC=false
SITE_SYNC_INTERVAL_MINUTES=60
SITE_BATCH_SIZE=12
# При необходимости переопределите публичную ссылку канала
SITE_CHANNEL_URL=https://t.me/kinojdun_channel

# SEO-верификация и аналитика
SITE_YANDEX_VERIFICATION=
SITE_GOOGLE_VERIFICATION=
SITE_YANDEX_METRIKA_ID=

# Карточки: 30 новых в московский день, свежие релизы и высокий рейтинг
SITE_DAILY_CARDS=30
SITE_MIN_RATING=6.0
SITE_MIN_VOTES=50
SITE_MIN_POPULARITY=5
# Более строгий отбор азиатских проектов без российского релиза/официального RU-трейлера.
SITE_ASIAN_MIN_VOTES=1000
SITE_ASIAN_MIN_POPULARITY=20
# Редакционные исключения для ожидаемых проектов: tv:ID,movie:ID (не отменяют фильтр ток-шоу).
SITE_AUDIENCE_ALLOW_KEYS=


# Настройки сообщества ВКонтакте (автопостинг для раскрутки сайта и SEO)
# Токен группы VK с правами 'wall', 'photos' (Управление сообществом -> Работа с API -> Создать ключ)
VK_ACCESS_TOKEN=
# Пользовательский токен администратора с правами photos (токен сообщества не подходит)
VK_USER_TOKEN=
# Числовой ID сообщества (положительное целое число, без минуса)
VK_GROUP_ID=
# Включение публикаций в VK (true/false)
VK_POSTING_ENABLED=false
# true — сразу публиковать, false — ручной запуск/проверка
VK_AUTO_PUBLISH=false
# Время по Москве; одна карточка в день, воскресенье — пауза
VK_POST_HOUR=18
VK_POST_MINUTE=30
VK_POST_DAYS=mon-sat
VK_ATTACHMENT_MODE=photo
# true — размещать ссылку в первом комментарии
# false — ссылка в конце текста поста
VK_LINK_IN_COMMENT=false
# Создавать и прикреплять интерактивный опрос к каждому посту
VK_CREATE_POLL=true

# Настройки канала Дзен (dzen.ru)
# Включение автопостинга в Дзен (true/false)
DZEN_POSTING_ENABLED=false
# Автоматическая публикация (true — авторежим, false — очередь/ручной запуск)
DZEN_AUTO_PUBLISH=true
# Режим синхронизации:
#   telegram_sync — через существующее подключение Telegram → Дзен; только исходные посты канала
#   webhook       — отправка через вебхук / SMM-сервис
#   rss           — подготовка черновика в журнале; лента сайта управляется отдельно
#   direct        — не поддерживается; не создаёт фиктивных публикаций
DZEN_SYNC_MODE=telegram_sync
# Только для самостоятельного режима; telegram_sync следует исходному каналу
DZEN_POST_HOUR=18
DZEN_POST_MINUTE=30
DZEN_POST_DAYS=mon,wed,fri,sun
# Ссылка на канал в Дзене (например, https://dzen.ru/kinojdun)
DZEN_CHANNEL_URL=
# ID канала в Дзене (опционально)
DZEN_CHANNEL_ID=
# Минимальный интервал между публикациями в минутах (антиспам)
DZEN_MIN_POST_INTERVAL_MINUTES=15
# Вебхук или токен (при DZEN_SYNC_MODE=webhook или direct)
DZEN_WEBHOOK_URL=
DZEN_SESSION_TOKEN=

# ==============================================================================
# 5. Мессенджер МАКС (MAX Messenger / max.ru)
# ==============================================================================
# Токен бота, полученный на платформе MAX (business.max.ru)
MAX_BOT_TOKEN=your_max_bot_token_here
# База данных для бота в MAX (по умолчанию отдельный файл sqlite для изоляции ID)
MAX_DATABASE_URL=sqlite+aiosqlite:///./data/kinozhdun_max.db
# Юзернейм и ссылка на бота в MAX
MAX_BOT_USERNAME=id5001170357_1_bot
MAX_BOT_URL=https://max.ru/id5001170357_1_bot
MAX_CHANNEL_POSTING_ENABLED=false
MAX_CHANNEL_ID=
MAX_CHANNEL_SOURCE_DB=data/kinozhdun.db
MAX_CHANNEL_JOURNAL_DB=data/kinozhdun_max_channel.db

# VK messenger bot (separate from VK wall publishing credentials)
VK_BOT_TOKEN=
VK_BOT_GROUP_ID=242087163
VK_BOT_URL=https://vk.me/club242087163
VK_DATABASE_URL=sqlite+aiosqlite:///./data/kinozhdun_vk.db
